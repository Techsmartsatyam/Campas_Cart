PORT=5000
MONGO_URI=mongodb+srv://user:pass@cluster0.whawppn.mongodb.net/
CLIENT_URL=http://localhost:5173
JWT_SECRET=campuscart_super_secret_jwt_key_2026
JWT_EXPIRES_IN=15d
COOKIE_NAME=campuscart_token
NODE_ENV=development

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# OR JSON String:
# FIREBASE_SERVICE_ACCOUNT=

# SMTP Email Service Configuration
# NOTE: Raw SMTP (Gmail) is BLOCKED on Render free tier.
# Use Brevo (brevo.com) HTTP API instead — free, no domain verification required.
# 1. Sign up at brevo.com with SMTP_USER email
# 2. Verify your sender email address in Brevo
# 3. Go to Settings → SMTP & API → API Keys → Create API key
# 4. Paste the key below and also set it in your Render environment variables
BREVO_API_KEY=your_brevo_api_key_here

# SMTP credentials (used as fallback for local dev only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=NearCart Platform
